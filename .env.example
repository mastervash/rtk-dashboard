# Path to the rtk history database (default: ~/.local/share/rtk/history.db)
RTKDASH_DB=/home/you/.local/share/rtk/history.db

# Directory holding config.toml and filters.toml (default: ~/.config/rtk)
RTKDASH_CONFIG_DIR=/home/you/.config/rtk

# rtk binary used by the tools runner (default: rtk from PATH)
RTKDASH_RTK_BIN=rtk

# Ports and bind address. Keep the host on loopback unless an authenticating
# reverse proxy sits in front.
RTKDASH_API_PORT=5178
RTKDASH_WEB_PORT=5177
RTKDASH_HOST=127.0.0.1

# Public origin(s) the reverse proxy serves the dashboard on, comma-separated.
# Loopback is always allowed. "*" disables the origin check entirely.
RTKDASH_ALLOWED_ORIGINS=https://rtk.example.com

# Set when running behind a proxy so Express reads X-Forwarded-* (e.g. "loopback", "1")
RTKDASH_TRUST_PROXY=loopback

# Set to 1 to disable the /api/run command runner and config writes
RTKDASH_READONLY=0
